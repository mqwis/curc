<Window x:Class="curs.Views.Dialogs.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт визитки"
        Width="440"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- заголовок окна -->
        <TextBlock Text="Экспорт визитки" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Формат файла" />
            <ComboBox SelectedIndex="0" Margin="0,4,0,12">
                <ComboBoxItem Content="PNG — высокое качество" />
                <ComboBoxItem Content="JPEG — компактный файл" />
                <ComboBoxItem Content="PDF — для печати" />
            </ComboBox>

            <TextBlock Text="Разрешение" />
            <ComboBox SelectedIndex="2" Margin="0,4,0,12">
                <ComboBoxItem Content="72 DPI — экран" />
                <ComboBoxItem Content="150 DPI — черновая печать" />
                <ComboBoxItem Content="300 DPI — печать" />
                <ComboBoxItem Content="600 DPI — высокое качество" />
            </ComboBox>

            <TextBlock Text="Имя файла" />
            <TextBox Text="Моя визитка" Margin="0,4,0,12" />

            <TextBlock Text="Папка для сохранения" />
            <DockPanel Margin="0,4,0,10">
                <Button Content="Обзор..." DockPanel.Dock="Right" Margin="8,0,0,0" />
                <TextBox Text="Документы\Визитки" />
            </DockPanel>

            <CheckBox Content="Экспортировать с прозрачным фоном" Margin="0,4,0,8" />
            <TextBlock Text="Размер макета: 90 × 50 мм" />
        </StackPanel>

        <!-- кнопки окна -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="CloseButtonClick" Margin="0,0,8,0" />
            <Button Content="Экспортировать" />
        </StackPanel>
    </Grid>
</Window>