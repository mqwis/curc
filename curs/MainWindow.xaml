<Window x:Class="curs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:curs"
        mc:Ignorable="d"
        Title="Визитки — редактор"
        Height="720"
        Width="1180"
        MinHeight="600"
        MinWidth="900"
        Background="#F1F3F0"
        FontFamily="Segoe UI"
        FontSize="13">
    <!-- стили и цвета главного окна -->
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#202923" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B756E" />
        <SolidColorBrush x:Key="LineBrush" Color="#DDE2DC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#176B58" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <!-- основная сетка окна -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- верхнее меню -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE2DC" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- метка заголовка в верхней строке -->
                <TextBlock x:Name="HeaderProjectLabel"
                           DockPanel.Dock="Right"
                           Text="ПРОЕКТ  /  ВИЗИТКИ"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <MenuItem Header="Файл">
                        <MenuItem Header="Создать визитку" />
                        <MenuItem Header="Открыть..." />
                        <MenuItem Header="Сохранить" />
                        <Separator />
                        <MenuItem Header="Экспорт..." />
                        <MenuItem Header="Печать..." />
                    </MenuItem>
                    <MenuItem Header="Правка">
                        <MenuItem Header="Отменить" />
                        <MenuItem Header="Повторить" />
                    </MenuItem>
                    <MenuItem Header="Справка">
                        <MenuItem Header="О программе" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- панель инструментов -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDE2DC" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Предпросмотр" Margin="0,0,8,0" />
                    <Button Content="Сохранить" Background="#176B58" Foreground="White" BorderBrush="#176B58" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- заголовок панели инструментов -->
                    <TextBlock x:Name="EditorTitleLabel"
                               Text="Визитка"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <CheckBox x:Name="ShowHeadersCheckBox"
                              Content="Показывать заголовки"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Checked="ShowHeadersCheckBoxChanged"
                              Unchecked="ShowHeadersCheckBoxChanged" />
                    <Button Content="Новая" Margin="0,0,6,0" />
                    <Button Content="Открыть" Margin="0,0,6,0" />
                    <Button Content="Текст" Margin="0,0,6,0" />
                    <Button Content="Изображение" Margin="0,0,6,0" />
                    <Button Content="Фигура" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- рабочая область редактора -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- инструменты и шаблоны -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ЭЛЕМЕНТЫ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <Button Content="↖   Выбор" />
                        <Button Content="T    Текст" />
                        <Button Content="▧    Изображение" />
                        <Button Content="□    Фигура" />

                        <Separator Margin="0,12,0,14" Background="{StaticResource LineBrush}" />

                        <TextBlock Text="ШАБЛОНЫ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Height="62" Background="#EAF1EE" BorderBrush="#DDE2DC" BorderThickness="1">
                                    <Grid Margin="8">
                                        <Rectangle Width="6" Fill="#176B58" HorizontalAlignment="Left" />
                                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Rectangle Width="62" Height="5" Fill="#35443C" HorizontalAlignment="Left" />
                                            <Rectangle Width="42" Height="3" Fill="#91A198" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Минимализм" Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Height="62" Background="#F2EDE3" BorderBrush="#DDE2DC" BorderThickness="1">
                                    <Grid Margin="8">
                                        <Rectangle Height="5" Fill="#B65D3A" VerticalAlignment="Top" />
                                        <StackPanel VerticalAlignment="Center">
                                            <Rectangle Width="72" Height="5" Fill="#3C3A35" HorizontalAlignment="Center" />
                                            <Rectangle Width="44" Height="3" Fill="#9B9387" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Теплый акцент" Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Height="62" Background="#263B4A" BorderBrush="#DDE2DC" BorderThickness="1">
                                    <Grid Margin="8">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Rectangle Width="65" Height="5" Fill="#FFFFFF" />
                                            <Rectangle Width="42" Height="3" Fill="#B8C6CC" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Контраст" Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <Border Height="62" Background="#F1E7D2" BorderBrush="#DDE2DC" BorderThickness="1">
                                    <Grid Margin="8">
                                        <Rectangle Width="30" Fill="#D26A45" HorizontalAlignment="Right" />
                                        <Polygon Points="0,0 36,0 0,36" Fill="#176B58" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Rectangle Width="68" Height="5" Fill="#303B35" />
                                            <Rectangle Width="40" Height="3" Fill="#85877B" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Геометрия" Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <Border Height="62" Background="#E9F0F4" BorderBrush="#DDE2DC" BorderThickness="1">
                                    <Grid Margin="8">
                                        <Border Width="42" Background="#D7E5ED" HorizontalAlignment="Right" />
                                        <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                                            <Rectangle Width="64" Height="5" Fill="#29485B" HorizontalAlignment="Left" />
                                            <Rectangle Width="44" Height="3" Fill="#78909D" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Ellipse Width="12" Height="12" Fill="#D26A45" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Светлый акцент" Foreground="{StaticResource InkBrush}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- холст с макетом визитки -->
            <Grid Grid.Column="1" Margin="12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Макет визитки" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CardSize}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="−" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="100%" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="+" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="#E6EAE5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Viewbox Stretch="Uniform" Margin="28">
                        <Border Width="540" Height="300" Background="#FFFFFF" BorderBrush="#D5DCD6" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#176B58" />
                                <Grid Grid.Column="1" Margin="34,28">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="АННА СУМЦОВА" FontSize="26" FontWeight="SemiBold" Foreground="#202923" />
                                        <TextBlock Text="Графический дизайнер" FontSize="15" Foreground="#68766E" Margin="0,6,0,0" />
                                        <Border Height="1" Background="#DDE2DC" Margin="0,22,0,18" />
                                        <TextBlock Text="СТУДИЯ ФОРМА" FontSize="11" FontWeight="Bold" Foreground="#176B58" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="+7 900 000-00-00" FontSize="12" Foreground="#35443C" />
                                            <TextBlock Text="anna@example.ru" FontSize="12" Foreground="#35443C" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="www.studio.ru" FontSize="12" Foreground="#35443C" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- свойства выбранного элемента и список слоёв -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="СВОЙСТВА" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Выбранный элемент" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" />

                        <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ElementNameTextBox"
                                 Text="{Binding SelectedElementName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,6" />
                        <!-- возвращает стандартное название элемента -->
                        <Button Content="Сбросить название"
                                Margin="0,0,0,10"
                                Click="ResetElementNameClick" />

                        <TextBlock Text="Тип элемента" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Текст" />
                            <ComboBoxItem Content="Изображение" />
                            <ComboBoxItem Content="Фигура" />
                        </ComboBox>

                        <Separator Margin="0,2,0,12" Background="{StaticResource LineBrush}" />
                        <TextBlock Text="ПОЛОЖЕНИЕ И РАЗМЕР" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X, мм" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y, мм" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="12" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ширина" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="45" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Высота" Foreground="{StaticResource MutedBrush}" />
                                <TextBox Text="8" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,14,0,12" Background="{StaticResource LineBrush}" />
                        <TextBlock Text="ОФОРМЛЕНИЕ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Шрифт" Foreground="{StaticResource MutedBrush}" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Arial" />
                            <ComboBoxItem Content="Georgia" />
                        </ComboBox>
                        <TextBlock Text="Размер текста" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="18" Margin="0,4,0,10" />
                        <TextBlock Text="Цвет текста" Foreground="{StaticResource MutedBrush}" />
                        <DockPanel Margin="0,4,0,10">
                            <Border Width="26" Height="26" Background="#202923" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBox Text="#202923" />
                        </DockPanel>
                        <CheckBox Content="Полужирный" Margin="0,2,0,6" />
                        <CheckBox Content="Курсив" Margin="0,0,0,6" />

                        <Separator Margin="0,10,0,12" Background="{StaticResource LineBrush}" />
                        <TextBlock Text="Слои" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,8" />
                        <ListBox BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MinHeight="88">
                            <ListBoxItem Content="Имя и фамилия" IsSelected="True" />
                            <ListBoxItem Content="Должность" />
                            <ListBoxItem Content="Контакты" />
                            <ListBoxItem Content="Зеленая линия" />
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- строка состояния -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DDE2DC" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding CardSize}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
